# ============================================================================
# Tellybase — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# See SETUP.md for how to obtain each value.
# ============================================================================

# Clerk (authentication — required)
# https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Telegram (platform owner's storage + the app's metadata database)
# Get TELEGRAM_BOT_TOKEN from @BotFather. TELEGRAM_CHAT_ID is the id of the
# private channel/group the bot posts files into (see SETUP.md).
#
# These are the OWNER's credentials: they store the app's metadata database
# (users, files, folders, plans, activity) so it survives serverless cold
# starts. They are also the default file-storage backend for users who have not
# connected their own Telegram. The bot must be an admin of the chat and the
# chat must be private.
#
# Each end user can connect their OWN bot + chat in Settings so their uploaded
# files are stored in their own Telegram ("bring your own Telegram"). That
# config is kept per-user (tg_bot_token / tg_chat_id) and never sent to the
# browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: override the Telegram Bot API base URL (defaults to the official
# API). Only needed for self-hosted/MTProto proxies or testing.
# TELEGRAM_API_BASE=https://api.telegram.org

# Storage backend selection: "auto" | "telegram" | "local"
# auto = use Telegram when tokens are set, else local disk (dev fallback)
STORAGE_BACKEND=auto

# Comma-separated Clerk user ids allowed to access the admin dashboard
ADMIN_USER_IDS=

# Local data directory (sqlite + local backend files)
DATA_DIR=data

# Recycle bin retention in days
RECYCLE_RETENTION_DAYS=30
