# Telegram is the production account database.
# Add both values to Vercel for Production and Preview environments.

# Channel 1 — Authentication Database (required for auth)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-100...

# Channel 2 — User Storage (private channel for all user files)
# If not set, uploads fall back to TELEGRAM_CHAT_ID (single-channel mode).
# Recommended: create a second private channel, add the same bot as admin, and set its ID here.
TELEGRAM_STORAGE_CHAT_ID=-100...
# Optional: separate bot token for storage channel (defaults to TELEGRAM_BOT_TOKEN)
# TELEGRAM_STORAGE_BOT_TOKEN=

# Optional but recommended. If omitted, the bot token signs sessions.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Admin accounts (comma-separated emails, case-insensitive).
# Accounts listed here (or promoted via the Admin page) see the Admin section
# in the dashboard navigation.
# ADMIN_EMAILS=you@example.com

# Optional override for testing/self-hosted Telegram Bot API.
# TELEGRAM_API_BASE=https://api.telegram.org

# UI Feature flags
# Set to "true" to show Personal Storage / Bot setup / Configure Telegram in the dashboard.
# Default is hidden (recommended).
# NEXT_PUBLIC_ENABLE_TELEGRAM_SETUP=false
