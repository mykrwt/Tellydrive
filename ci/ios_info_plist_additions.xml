<!--
  Reference Info.plist ADDITIONS for TellyBase, not a full iOS project.

  Like the Android manifest fragment next to this file, the ios/ platform
  folder itself is generated by `flutter create .`. Merge these keys into
  the generated ios/Runner/Info.plist.
-->
<plist>
<dict>
    <!-- Smart Backup: reading the Camera Roll. -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>TellyBase backs up the photos and videos you choose directly to your own Telegram account.</string>

    <!-- Saving downloaded originals back to the Camera Roll. -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>TellyBase saves files you download from your Telegram vault back to your photo library when you ask it to.</string>

    <!-- Background uploads/downloads continuing after the app is backgrounded. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>processing</string>
    </array>

    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>tellybase.periodic_backup</string>
        <string>tellybase.cache_cleanup</string>
    </array>
</dict>
</plist>
