# SYSTEM A — PRIVATE BACKEND INFRASTRUCTURE ONLY
#
# Copy variable names into the backend's secret manager and supply the real
# values there. Never expose these values through NEXT_PUBLIC_ variables,
# Flutter build defines, mobile resources, client JavaScript, logs, or APIs.

# Private account-database bot and channel (backend required in production)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Private file-storage channel (falls back to the private account channel when
# intentionally left unset by the operator)
TELEGRAM_STORAGE_CHAT_ID=

# Optional private storage bot (falls back to the private account bot when
# intentionally left unset by the operator)
TELEGRAM_STORAGE_BOT_TOKEN=

# Backend session/upload-capability signing material
SESSION_SECRET=

# Backend authorization bootstrap list (comma-separated operator accounts)
ADMIN_EMAILS=

# Optional backend-only Telegram Bot API origin override
TELEGRAM_API_BASE=
